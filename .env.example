# Public origin of this Next.js app. Used for metadata and as the Better Auth
# base URL, because auth requests are proxied through this origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public URL of the Express API. The browser calls this directly for REST.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional. Only set this when the auth server must be reached at a different
# public origin than NEXT_PUBLIC_APP_URL. Leave blank in the standard setup.
# NEXT_PUBLIC_BETTER_AUTH_URL=

# Server-only. The /api/auth/* route proxies to this origin so session cookies
# stay first-party. Never prefix this with NEXT_PUBLIC_.
BACKEND_URL=http://localhost:5000

# Set to "false" when Google OAuth is not configured on the backend, to hide
# the Google buttons on the sign-in and sign-up pages.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
